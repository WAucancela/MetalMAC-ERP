# ─── Supabase ──────────────────────────────────────────────────────────────────
# Local dev: valores impresos por `npx supabase start` (ver supabase/config.toml).
# Producción: Supabase Dashboard → Project Settings → API.
# NOTA: la verificación de JWT en app/api/_helpers.ts usa el endpoint JWKS del proyecto
# (claves asimétricas ES256), no el secreto HS256 "legacy" — no hace falta SUPABASE_JWT_SECRET.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── WooCommerce (tallermac.com) ───────────────────────────────────────────────
# Secreto configurado al crear el webhook en WooCommerce → Ajustes → Avanzado →
# Webhooks. Sólo se usa para verificar la firma HMAC de app/api/webhooks/woocommerce
# — no se necesita Consumer Key/Secret de la REST API para esta fase.
WOOCOMMERCE_WEBHOOK_SECRET=
