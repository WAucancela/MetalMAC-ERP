# ─── Firebase Client SDK (expuesto al browser — sin secretos) ─────────────────
# NOTA: en migración a Supabase — mantener mientras el código Firebase siga en uso.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (SOLO server-side — NUNCA exponer al cliente) ─────────
# Obtener desde Firebase Console → Configuración del proyecto → Cuentas de servicio
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# La clave privada tiene saltos de línea — en .env.local usar \n literal:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Supabase (nuevo backend — ver plan de migración) ─────────────────────────
# Local dev: valores impresos por `npx supabase start` (ver supabase/config.toml).
# Producción: Supabase Dashboard → Project Settings → API.
# NOTA: la verificación de JWT en app/api/_helpers.ts usa el endpoint JWKS del proyecto
# (claves asimétricas ES256), no el secreto HS256 "legacy" — no hace falta SUPABASE_JWT_SECRET.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
