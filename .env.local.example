# ─── Supabase ──────────────────────────────────────────────────────────────────
# Local dev: valores impresos por `npx supabase start` (ver supabase/config.toml).
# Producción: Supabase Dashboard → Project Settings → API.
# NOTA: la verificación de JWT en app/api/_helpers.ts usa el endpoint JWKS del proyecto
# (claves asimétricas ES256), no el secreto HS256 "legacy" — no hace falta SUPABASE_JWT_SECRET.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── WooCommerce (tallermac.com) ───────────────────────────────────────────────
# Secreto configurado al crear el webhook en WooCommerce → Ajustes → Avanzado →
# Webhooks. Sólo se usa para verificar la firma HMAC de app/api/webhooks/woocommerce.
WOOCOMMERCE_WEBHOOK_SECRET=

# Consumer Key/Secret de la REST API de WooCommerce — generadas en WooCommerce →
# Ajustes → Avanzado → API REST → Agregar clave (permisos: Lectura/Escritura). Se
# usan para publicar productos del ERP hacia la tienda (app/api/productos/[id]/publicar-tienda).
# WOOCOMMERCE_API_URL sin slash final, ej. https://tallermac.com
WOOCOMMERCE_API_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ─── Facturación electrónica (SRI) ─────────────────────────────────────────────
# Clave simétrica AES-256-GCM (32 bytes en hex, 64 caracteres) usada para cifrar
# la contraseña del .p12 de firma y la API key de Resend antes de guardarlas en
# Postgres (ver lib/services/cifrado.service.ts). Generar una vez con:
#   openssl rand -hex 32
# y no cambiarla nunca en producción — cambiarla invalida todo lo ya cifrado.
CERT_ENCRYPTION_KEY=

# ─── Resend (envío del RIDE por email) ─────────────────────────────────────────
# La API key se configura desde la UI (Configuración → SRI / Email) y se guarda
# cifrada en la base — no va acá. RESEND_FROM_EMAIL es el único dato que sí se lee
# directo de env como fallback si no se configuró desde la UI (ver
# scripts/set-configuracion-sri-pruebas.ts).
RESEND_FROM_EMAIL=

# ─── Cron (seguimiento de cotizaciones) ────────────────────────────────────────
# Vercel Cron agrega automáticamente el header `Authorization: Bearer $CRON_SECRET`
# a las llamadas programadas — sin este secreto, cualquiera podría pegarle a
# app/api/cron/seguimiento-cotizaciones y disparar emails a clientes reales.
CRON_SECRET=

# ─── Anthropic (generación de líneas de cotización con IA, agente de WhatsApp) ─
# Leída implícitamente por el SDK (`new Anthropic()`) — no hace falta pasarla
# a mano al cliente. La usan cotizacion-ia.service.ts y whatsapp-agente.service.ts.
ANTHROPIC_API_KEY=

# ─── WhatsApp Cloud API (agente de ventas, Meta) ───────────────────────────────
# Todo esto se obtiene en developers.facebook.com → tu App → WhatsApp → API Setup
# (o Business Settings si ya promoviste el número a producción).
#
# Token del System User / app de Meta con permiso whatsapp_business_messaging —
# usado por lib/services/whatsapp.service.ts para enviar mensajes. Un token
# temporal de 24h sirve para probar; para producción generá uno permanente desde
# un System User en Meta Business Suite.
WHATSAPP_ACCESS_TOKEN=
# El id del número de WhatsApp Business del taller (no es el número de teléfono
# en sí) — WhatsApp → API Setup → "Phone number ID".
WHATSAPP_PHONE_NUMBER_ID=
# Cadena random que vos elegís y pegás también en Meta → WhatsApp → Configuration
# → Webhook → "Verify token", para el handshake de verificación (GET a este
# mismo endpoint). Generar con: openssl rand -hex 24
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración básica de la app) — usado para
# verificar la firma `X-Hub-Signature-256` de cada webhook entrante, igual que
# WOOCOMMERCE_WEBHOOK_SECRET verifica el de WooCommerce.
WHATSAPP_APP_SECRET=
