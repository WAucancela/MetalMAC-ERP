rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers de roles ──────────────────────────────────────────────────
    function isAuth()         { return request.auth != null; }
    function rol()            { return request.auth.token.rol; }
    function isGerente()      { return isAuth() && rol() == 'GERENTE'; }
    function isBodeguero()    { return isAuth() && (rol() == 'BODEGUERO'   || rol() == 'GERENTE'); }
    function isProduccion()   { return isAuth() && (rol() == 'PRODUCCION'  || rol() == 'GERENTE'); }
    function isContabilidad() { return isAuth() && (rol() == 'CONTABILIDAD'|| rol() == 'GERENTE'); }

    // ─── Catálogos ─────────────────────────────────────────────────────────
    match /unidades_medida/{id} {
      allow read:  if isAuth();
      allow write: if isBodeguero();
    }
    match /categorias/{id} {
      allow read:  if isAuth();
      allow write: if isBodeguero();
    }

    // ─── Inventario ────────────────────────────────────────────────────────
    match /materiales/{id} {
      allow read:  if isAuth();
      allow write: if isBodeguero();
    }
    // stock y movimientos: escritura SOLO vía Admin SDK (API Routes)
    match /stock/{id} {
      allow read:  if isAuth();
      allow write: if false;
    }
    match /movimientos_inventario/{id} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ─── Proveedores ───────────────────────────────────────────────────────
    match /proveedores/{id} {
      allow read:  if isAuth();
      allow write: if isContabilidad();
      match /contactos/{cid} {
        allow read:  if isAuth();
        allow write: if isContabilidad();
      }
    }
    match /tabla_equivalencias/{id} {
      allow read:  if isAuth();
      allow write: if isContabilidad();
    }

    // ─── Contabilidad ──────────────────────────────────────────────────────
    match /facturas_compra/{id} {
      allow read:  if isContabilidad();
      allow write: if false;   // Solo Admin SDK
    }
    match /facturas_venta/{id} {
      allow read:  if isContabilidad();
      allow write: if false;
    }

    // ─── Producción ────────────────────────────────────────────────────────
    match /productos/{id} {
      allow read:  if isAuth();
      allow write: if isProduccion();
    }
    match /bom/{id} {
      allow read:  if isAuth();
      allow write: if isProduccion();
    }
    match /ordenes_produccion/{id} {
      allow read:  if isAuth();
      allow write: if false;   // Transiciones de estado: solo Admin SDK
    }

    // ─── Proyectos ─────────────────────────────────────────────────────────
    match /proyectos/{id} {
      allow read:  if isAuth();
      allow write: if false;   // Solo Admin SDK (costoReal atómico)
    }
    match /gastos_proyecto/{id} {
      allow read:  if isAuth();
      allow write: if false;   // Solo Admin SDK (transacción con costoReal)
    }

    // ─── Contadores de secuencia ───────────────────────────────────────────
    // OP-YYYY-NNNN y PRY-YYYY-NNNN: solo Admin SDK
    match /_counters/{id} {
      allow read:  if false;
      allow write: if false;
    }

    // ─── Todo lo demás: denegado ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
