rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Archivos XML de facturas — solo lectura autenticada
    // Escritura SOLO desde Admin SDK (API Routes server-side)
    match /facturas/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Comprobantes de gastos de proyecto
    match /comprobantes/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Bloquear todo lo demás por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
